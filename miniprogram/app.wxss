page {
  --bg: #ffffff;
  --fg: #111111;
  --muted: #8a8a8a;
  --line: #ebebeb;
  --ok: #1d9e75;
  --err: #d85a30;

  background: var(--bg);
  color: var(--fg);
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 32rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.label {
  color: var(--muted);
}

.value {
  font-family: monospace;
  word-break: break-all;
}

.btn {
  margin-top: 32rpx;
  background: #111111;
  color: #ffffff;
  border-radius: 8rpx;
  padding: 24rpx;
  text-align: center;
}

.btn:active {
  opacity: 0.8;
}

.panel {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  font-family: monospace;
  font-size: 24rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
