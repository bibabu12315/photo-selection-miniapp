/* 设计 token（54 文档第 1 节 · 与网页端同值，仅单位换成 rpx：1px ≈ 1.8rpx） */
page {
  --fg: #1a1a18;
  --fg2: #55544e;
  --muted: #8a897f;
  --page: #f4f4f2;
  --panel: #ffffff;
  --line: #e5e4df;
  --line2: #d8d7d0;

  /* 照片区深底（新）：不是纯黑，留一点暖灰 */
  --dark: #1c1c1a;
  --dark2: #262624;
  --dark-line: #3a3a36;

  --ok: #2f7d4f;
  --warn: #9a6b00;
  --info: #3a5fa8;
  --err: #b03a32;

  /* 圆角：卡片 14px / 控件 8px / 徽标全圆 */
  --r-card: 26rpx;
  --r-ctl: 14rpx;
  --r-pill: 999rpx;

  /* 旧名保留：现有页面样式仍引用，值统一对齐上面这套 */
  --bg: #ffffff;
  --chip: #f2f2f0;
  --ok-bg: #e4f0e8;
  --err-bg: #fbedeb;
  --green: #2f7d4f;
  --green-bg: #e4f0e8;
  --amber: #9a6b00;
  --amber-bg: #f7efdc;
  --red: #b03a32;
  --red-bg: #fbedeb;

  background: var(--bg);
  color: var(--fg);
  font-size: 28rpx;
  line-height: 1.6;
}

/* ---------- 通用容器 ---------- */

.page {
  min-height: 100vh;
  background: var(--page);
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sect-title {
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
  margin: 8rpx 0 4rpx 8rpx;
}

.hint {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.7;
}

.hr {
  height: 1rpx;
  background: var(--line);
  margin: 18rpx 0;
}

.empty {
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
  padding: 120rpx 40rpx;
  line-height: 1.9;
}

/* ---------- 按钮 ---------- */

.btn {
  background: #1a1a1a;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
}

.btn:active {
  opacity: 0.85;
}

.btn.ghost {
  background: #ffffff;
  color: var(--fg);
  border: 1rpx solid var(--line2);
}

.btn.small {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
}

.btn.disabled {
  background: #e6e6e6;
  color: #a8a8a8;
}

/* ---------- 状态胶囊 ---------- */

.chip {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--chip);
  color: var(--fg2);
}

.chip.green {
  background: var(--green-bg);
  color: var(--green);
}

.chip.amber {
  background: var(--amber-bg);
  color: var(--amber);
}

.chip.red {
  background: var(--red-bg);
  color: var(--red);
}

.chip.solid {
  background: #1a1a1a;
  color: #ffffff;
}

/* 已归档：中性灰，不抢已过期/已提交的注意力 */
.chip.grey {
  background: #ececec;
  color: #8a8a8a;
}

/* ---------- 表单 ---------- */

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.field .label {
  font-size: 26rpx;
  color: var(--muted);
}

.field .value {
  font-size: 26rpx;
  color: var(--fg);
}

.field .value.placeholder {
  color: #b8b8b8;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.meta {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
}
