.page {
  padding-bottom: 80rpx;
}

.head {
  padding: 8rpx 8rpx 24rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
}

.note {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
}

.model-row {
  align-items: flex-start;
}

.model-info {
  flex: 1;
}

.model-name {
  font-size: 28rpx;
  font-weight: 500;
}

.ops {
  display: flex;
  gap: 12rpx;
  margin: 16rpx 0 4rpx;
}

.op {
  font-size: 22rpx;
  color: var(--fg2);
  background: var(--chip);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.op.danger {
  color: var(--red);
  background: var(--red-bg);
}

.add-model {
  margin-top: 20rpx;
}

.empty-mini {
  font-size: 24rpx;
  color: var(--muted);
  padding: 16rpx 0 4rpx;
}

.arrow {
  font-size: 34rpx;
  color: #c8c8c8;
}

.qr-card {
  text-align: center;
}

.qr {
  width: 360rpx;
  margin: 0 auto 16rpx;
  display: block;
}

.links {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 16rpx 40rpx;
}

.link {
  font-size: 24rpx;
  color: var(--muted);
}

.link.danger {
  color: var(--red);
}

/* ---------- 弹层 ---------- */

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  z-index: 100;
}

.modal {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
}

.modal-desc {
  font-size: 24rpx;
  color: var(--muted);
  margin: 8rpx 0 16rpx;
  line-height: 1.7;
}

.url-box {
  background: #f6f6f6;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 22rpx;
  color: var(--fg2);
  word-break: break-all;
  margin-bottom: 20rpx;
}

.code-box {
  background: #f6f6f6;
  border: 1rpx dashed var(--line2);
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
  margin-bottom: 20rpx;
}

.modal-input {
  background: #f6f6f6;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.row.gap {
  gap: 16rpx;
}

.row.gap .btn {
  flex: 1;
}

.modal-hint {
  margin: 16rpx 0 12rpx;
  text-align: center;
}

.close {
  width: 100%;
}
