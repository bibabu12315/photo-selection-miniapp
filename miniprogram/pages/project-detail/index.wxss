.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f7f5;
}

.hint {
  margin-top: 120rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.head {
  margin-bottom: 32rpx;
}

.name {
  font-size: 40rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 12rpx;
}

.meta {
  font-size: 26rpx;
  color: #888;
  line-height: 1.8;
}

.panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 24rpx;
}

.code {
  font-size: 72rpx;
  font-weight: 600;
  letter-spacing: 12rpx;
  text-align: center;
  color: #111;
  padding: 20rpx 0;
}

.code.empty {
  color: #ccc;
}

.code-hint {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 32rpx;
}

.btn {
  background: #111;
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
}

.btn.disabled {
  opacity: 0.5;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.btn.half {
  flex: 1;
  padding: 22rpx 0;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* button 自带样式清零，对齐自绘按钮 */
.share-btn {
  margin: 0;
  line-height: 1.2;
  border-radius: 12rpx;
}

.share-btn::after {
  border: none;
}

/* 次要按钮：白底描边，用于非主流程操作 */
.btn.ghost {
  margin-top: 16rpx;
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
  box-sizing: border-box;
}

.qr-wrap {
  margin-top: 24rpx;
  text-align: center;
}

.qr {
  width: 380rpx;
  margin: 0 auto 16rpx;
  display: block;
}

.note {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
}

.todo {
  font-size: 26rpx;
  color: #bbb;
  line-height: 1.8;
}
