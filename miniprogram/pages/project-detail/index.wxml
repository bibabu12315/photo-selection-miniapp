<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{project}}">
    <view class="head">
      <view class="name">{{project.name}}</view>
      <view class="meta">{{shoot}} · 有效期至 {{expire}} · 套餐 {{pkg}}</view>
      <view wx:if="{{note}}" class="note">备注：{{note}}</view>
    </view>

    <!-- ① 照片 -->
    <view class="sect-title">① 照片</view>
    <view class="card">
      <view class="row">
        <view>
          <view class="card-title">
            {{project.photoCount > 0 ? '已上传 ' + project.photoCount + ' 张' : '还没有照片'}}
          </view>
          <view class="meta">
            {{project.photoCount > 0 ? '可继续追加上传，同名文件会覆盖' : '在电脑上把 JPG 传进这个项目'}}
          </view>
        </view>
      </view>
      <view class="hr"></view>
      <view class="btn" bindtap="openUpload">
        {{project.photoCount > 0 ? '继续上传照片' : '去电脑上传'}}
      </view>
    </view>

    <!-- ② 模特 -->
    <view class="sect-title">② 模特 {{modelCountText}}</view>
    <view class="card">
      <view wx:if="{{models.length === 0}}" class="empty-mini">
        还没有邀请模特，上传照片后再邀请
      </view>

      <block wx:for="{{models}}" wx:key="modelId">
        <view class="row model-row">
          <view class="model-info">
            <view class="model-name">{{item.name}}</view>
            <view class="meta">{{item.progress}}</view>
          </view>
          <view class="chip {{item.statusClass}}">{{item.status}}</view>
        </view>
        <view class="ops">
          <view class="op" data-index="{{index}}" bindtap="copyInviteLink">复制链接</view>
          <view class="op" data-index="{{index}}" bindtap="makeQrCode">
            {{qrMaking ? '生成中…' : '小程序码'}}
          </view>
          <view class="op danger" data-index="{{index}}" bindtap="tapRemoveInvite">移除</view>
        </view>
        <view class="hr" wx:if="{{index < models.length - 1}}"></view>
      </block>

      <view class="btn ghost small add-model" bindtap="openInviteModal">+ 邀请模特</view>
      <view class="hint">每个项目最多 5 位模特，每人一条独立链接，各选各的</view>
    </view>

    <view wx:if="{{qrFileID}}" class="card qr-card">
      <image class="qr" src="{{qrFileID}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
      <view class="hint">长按可保存。认证通过后也可以直接用右上角「分享」发给模特。</view>
      <view class="btn ghost small" bindtap="closeQr">收起</view>
    </view>

    <!-- ③ 结果 -->
    <view class="sect-title">③ 结果</view>
    <view class="card">
      <view class="row" bindtap="openResult">
        <view>
          <view class="card-title">查看选片结果</view>
          <view class="meta">
            {{submittedCount > 0 ? '已有 ' + submittedCount + ' 位模特提交' : '还没有模特提交'}}
          </view>
        </view>
        <view class="arrow">›</view>
      </view>
    </view>

    <view class="links">
      <view class="link" bindtap="extend">延期 30 天</view>
      <view class="link danger" bindtap="tapRemoveProject">删除项目</view>
    </view>
  </block>
</view>

<!-- 上传引导弹层 -->
<view wx:if="{{showUpload}}" class="mask" bindtap="closeUpload">
  <view class="modal" catchtap="noop">
    <view class="modal-title">在电脑上上传照片</view>
    <view class="modal-desc">点网址直接复制，去电脑浏览器粘贴即可打开</view>
    <view class="url-box" bindtap="copyUploadUrl">{{uploadUrl}}</view>
    <view class="modal-desc">打开后输入这 6 位上传码（5 分钟内有效）</view>
    <view class="code-box" bindtap="copyUploadCode">{{code}}</view>
    <view class="row gap">
      <view class="btn ghost small {{issuing ? 'disabled' : ''}}" bindtap="generateCode">
        {{issuing ? '刷新中…' : '刷新上传码'}}
      </view>
      <view class="btn ghost small" bindtap="copyUploadInfo">复制网址 + 码</view>
    </view>
    <view class="hint modal-hint">
      只上传 JPG，ARW 会自动跳过，文件名保持相机原名
    </view>
    <view class="btn ghost small close" bindtap="closeUpload">关闭</view>
  </view>
</view>

<!-- 邀请模特弹层 -->
<view wx:if="{{showInvite}}" class="mask" bindtap="closeInviteModal">
  <view class="modal" catchtap="noop">
    <view class="modal-title">邀请模特</view>
    <view class="modal-desc">名字只是备注，方便你区分（如「小王」），模特不需要注册</view>
    <input
      class="modal-input"
      type="text"
      placeholder="模特名字"
      maxlength="20"
      value="{{inviteName}}"
      bindinput="onInviteName"
      focus="{{true}}"
      confirm-type="done"
      bindconfirm="confirmInvite"
    />
    <view class="row gap">
      <view class="btn ghost small" bindtap="closeInviteModal">取消</view>
      <view class="btn small {{inviting ? 'disabled' : ''}}" bindtap="confirmInvite">
        {{inviting ? '生成中…' : '生成邀请链接'}}
      </view>
    </view>
  </view>
</view>
