.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f7f5;
}

.hint {
  margin-top: 120rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.hint2 {
  margin-top: 16rpx;
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
}

.head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.count {
  flex: 1;
  font-size: 30rpx;
  color: #111;
}

.num {
  color: #1f8a4c;
  font-weight: 600;
}

.head-btns {
  display: flex;
  gap: 16rpx;
}

.mini-btn {
  font-size: 24rpx;
  color: #111;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
}

.list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0ee;
}

.row:last-child {
  border-bottom: none;
}

.row-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: #eee;
  flex-shrink: 0;
}

.row-name {
  flex: 1;
  margin-left: 24rpx;
  font-size: 28rpx;
  color: #111;
  font-family: Menlo, Consolas, monospace;
}

.row-idx {
  color: #bbb;
  font-size: 24rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cell {
  width: calc((100% - 24rpx) / 4);
  height: 165rpx;
  background: #eee;
  border-radius: 8rpx;
  overflow: hidden;
}

.cell-img {
  width: 100%;
  height: 100%;
}

.note {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
}

.bottom-space {
  height: 140rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #f7f7f5;
  border-top: 1rpx solid #e5e5e0;
}

.bar-btn {
  background: #111;
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  padding: 22rpx;
  border-radius: 12rpx;
}

.bar-btn.ghost {
  background: #fff;
  color: #c0392b;
  border: 1rpx solid #e0b4ae;
}

.bar-btn.disabled {
  opacity: 0.5;
}
