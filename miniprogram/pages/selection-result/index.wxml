<view class="page">
  <view wx:if="{{loading && photos.length === 0}}" class="empty">加载中…</view>

  <block wx:else>
    <!-- 模特切换 -->
    <view class="tabs" wx:if="{{tabs.length > 0}}">
      <view
        class="tab {{item.active ? 'on' : ''}}"
        wx:for="{{tabs}}"
        wx:key="modelId"
        data-id="{{item.modelId}}"
        bindtap="switchModel"
      >{{item.label}}</view>
    </view>

    <view wx:if="{{tabs.length === 0}}" class="empty">
      这个项目还没有邀请模特
      <view class="empty-sub">回到项目详情，在「② 模特」里先邀请模特</view>
    </view>

    <block wx:elif="{{photos.length === 0}}">
      <view class="empty">
        {{currentName}} 还没有提交选片
        <view class="empty-sub">她提交后，这里会显示选中的照片和文件名</view>
      </view>
    </block>

    <block wx:else>
      <view class="head">
        <view class="count">
          {{currentName}} 已选 <text class="num">{{selectedCount}}</text> 张
        </view>
        <view class="meta">套餐 {{pkg}} · {{submittedText}}</view>
        <view class="head-btns">
          <view class="mini-btn" bindtap="switchView">{{view === 'list' ? '网格' : '列表'}}</view>
          <view class="mini-btn" bindtap="copyAll">复制全部文件名</view>
        </view>
      </view>

      <view wx:if="{{view === 'list'}}" class="list">
        <view class="row" wx:for="{{photos}}" wx:key="_id">
          <image class="row-thumb" src="{{item.thumbUrl}}" mode="aspectFill" lazy-load="{{true}}" />
          <view class="row-name">{{item.filename}}</view>
          <view class="row-idx">{{index + 1}}</view>
        </view>
      </view>

      <view wx:else class="grid">
        <view class="cell" wx:for="{{photos}}" wx:key="_id">
          <image class="cell-img" src="{{item.thumbUrl}}" mode="aspectFill" lazy-load="{{true}}" />
        </view>
      </view>

      <view class="note">
        文件名与相机原名一致（按文件名升序）。精修时在 Lightroom 里按文件名对照找 ARW。
      </view>
    </block>

    <view class="bottom-space"></view>
    <view class="bar">
      <view class="bar-btn ghost {{resetting ? 'disabled' : ''}}" bindtap="reopen">
        {{currentName ? '重新开放「' + currentName + '」的选片' : '重新开放选片'}}
      </view>
    </view>
  </block>
</view>
