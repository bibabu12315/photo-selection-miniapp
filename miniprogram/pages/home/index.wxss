.page {
  padding-bottom: 160rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.models {
  font-size: 24rpx;
  color: var(--fg2);
  line-height: 1.8;
}

.empty-sub {
  font-size: 24rpx;
  color: #b0b0b0;
  margin-top: 12rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 64rpx;
  background: #1a1a1a;
  color: #ffffff;
  font-size: 28rpx;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
  z-index: 10;
}

.fab:active {
  opacity: 0.85;
}
