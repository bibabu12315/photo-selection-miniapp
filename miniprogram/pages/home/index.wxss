.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f7f5;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #111;
}

.add-btn {
  background: #111;
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
}

.hint {
  margin-top: 120rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
  line-height: 2;
}

.project-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.p-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 12rpx;
}

.p-meta {
  font-size: 24rpx;
  color: #888;
}

.btn {
  background: #111;
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
}

.bind-panel {
  margin-top: 160rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 40rpx;
}

.bind-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 16rpx;
}

.bind-hint {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 40rpx;
}

.bind-input {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  margin-bottom: 32rpx;
}

.bind-error {
  color: #d85a30;
  font-size: 26rpx;
  margin-top: 24rpx;
  text-align: center;
}

.bind-openid {
  margin-top: 40rpx;
  font-size: 22rpx;
  color: #bbb;
  word-break: break-all;
  text-align: center;
}
