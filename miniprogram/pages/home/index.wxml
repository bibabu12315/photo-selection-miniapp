<view class="page">
  <view wx:if="{{loading && projects.length === 0}}" class="empty">加载中…</view>

  <block wx:else>
    <view wx:if="{{projects.length === 0}}" class="empty">
      还没有项目
      <view class="empty-sub">点右上角「+ 新建」，创建后在电脑上上传照片</view>
    </view>

    <view
      class="card"
      wx:for="{{projects}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="openProject"
    >
      <view class="row">
        <view class="name">{{item.name}}</view>
        <view class="chip {{item.statusClass}}">{{item.status}}</view>
      </view>
      <view class="meta">{{item.meta}}</view>
      <view class="hr"></view>
      <view class="models">{{item.modelsLine}}</view>
    </view>
  </block>
</view>

<view class="fab" bindtap="goCreate">+ 新建</view>
