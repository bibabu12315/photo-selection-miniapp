.wrap {
  min-height: 100vh;
  background: #ffffff;
  padding: 120rpx 56rpx 80rpx;
  text-align: center;
  box-sizing: border-box;
}

.logo {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.slogan {
  font-size: 28rpx;
  color: var(--fg2);
  margin-top: 16rpx;
}

.desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 24rpx;
  line-height: 1.9;
}

.block {
  margin-top: 80rpx;
  text-align: center;
}

/* 摄影师 / 模特两个分支之间的分隔线 */
.divider {
  display: flex;
  align-items: center;
  margin-top: 56rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: var(--line);
}

.divider text {
  padding: 0 20rpx;
}

.sub-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.input {
  background: #f6f6f6;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.ph {
  color: #bbbbbb;
  font-size: 26rpx;
}

.tip {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 16rpx;
  line-height: 1.8;
}

.err {
  font-size: 24rpx;
  color: var(--red);
  margin-top: 12rpx;
}

.claim-ok {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--green);
}
