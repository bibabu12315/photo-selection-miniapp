.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f7f5;
}

.field {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.input {
  font-size: 32rpx;
  color: #111;
}

.btn {
  margin-top: 48rpx;
  background: #111;
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  padding: 26rpx;
  border-radius: 12rpx;
}

.btn.disabled {
  opacity: 0.5;
}

.note {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
}
