.page {
  padding-bottom: 60rpx;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}

.field-col {
  display: block;
}

.label {
  font-size: 26rpx;
  color: var(--muted);
  flex: none;
}

.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--fg);
}

.value {
  font-size: 28rpx;
  color: var(--fg);
}

.textarea {
  width: 100%;
  font-size: 28rpx;
  color: var(--fg);
  min-height: 120rpx;
}

.hint {
  font-size: 22rpx;
  color: var(--muted);
  padding: 0 8rpx 20rpx;
}
