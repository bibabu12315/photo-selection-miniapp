.page {
  min-height: 100vh;
  background: #0d0d0d;
  padding: 24rpx;
  box-sizing: border-box;
}

.center {
  margin-top: 30vh;
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 0 60rpx;
}

.err-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.err-text {
  line-height: 1.8;
}

/* 失败重试入口：弱网时可点击重来，而不是只有一个 toast */
.retry-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 40rpx;
  font-size: 26rpx;
  color: #ccc;
  border: 1rpx solid #444;
  border-radius: 999rpx;
}

.more.retry-btn {
  display: block;
  margin: 24rpx auto;
  padding: 16rpx 0;
  width: 320rpx;
  border: 1rpx solid #444;
  border-radius: 12rpx;
  color: #999;
}

.done-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: #1f8a4c;
  color: #fff;
  font-size: 64rpx;
}

.done-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.done-meta {
  color: #888;
  font-size: 28rpx;
  line-height: 1.8;
}

.done-hint {
  color: #666;
  font-size: 26rpx;
  line-height: 1.8;
  margin-top: 32rpx;
}

.reopen-btn {
  display: inline-block;
  margin-top: 40rpx;
  padding: 18rpx 64rpx;
  background: #ffffff;
  color: #111;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
}

/* 提交过一版的顶部提示条 */
.resubmit-tip {
  margin-bottom: 16rpx;
  padding: 14rpx 20rpx;
  background: #faeeda;
  color: #8a5a1e;
  font-size: 24rpx;
  line-height: 1.6;
  border-radius: 8rpx;
}

.head {
  margin-bottom: 24rpx;
}

.name {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.meta {
  color: #888;
  font-size: 26rpx;
}

.num {
  color: #4cd97b;
  font-weight: 600;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cell {
  position: relative;
  width: calc((100% - 16rpx) / 3);
  height: 220rpx;
  background: #1a1a1a;
  border-radius: 8rpx;
  overflow: hidden;
}

.thumb {
  width: 100%;
  height: 100%;
}

/* 徽章外层点击热区：视觉圆圈不变，可点面积更大，好按 */
.badge-hit {
  position: absolute;
  right: 0;
  top: 0;
  padding: 12rpx;
}

.badge {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  background: rgba(0, 0, 0, 0.35);
  color: transparent;
  font-size: 30rpx;
  box-sizing: border-box;
}

/* 选中：绿色实心圆 + 白色对勾，状态一眼可辨 */
.badge.on {
  background: #1f8a4c;
  border-color: #1f8a4c;
  color: #ffffff;
  font-weight: 600;
}

.head-left {
  flex: 1;
}

.select-all {
  flex: none;
  font-size: 24rpx;
  color: #cccccc;
  border: 1rpx solid #3a3a3a;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

.more {
  text-align: center;
  color: #666;
  font-size: 24rpx;
  padding: 24rpx 0;
}

.bar-space {
  height: 140rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #161616;
  border-top: 1rpx solid #2a2a2a;
}

.bar-info {
  flex: 1;
  color: #fff;
  font-size: 30rpx;
}

.bar-btn {
  background: #ffffff;
  color: #111111;
  font-size: 30rpx;
  padding: 20rpx 60rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.bar-btn.disabled {
  opacity: 0.5;
}
