.page {
  min-height: 100vh;
  background: #0d0d0d;
  padding: 24rpx;
  box-sizing: border-box;
}

.center {
  margin-top: 30vh;
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 0 60rpx;
}

.err-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.err-text {
  line-height: 1.8;
}

/* 失败重试入口：弱网时可点击重来，而不是只有一个 toast */
.retry-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 40rpx;
  font-size: 26rpx;
  color: #ccc;
  border: 1rpx solid #444;
  border-radius: 999rpx;
}

.more.retry-btn {
  display: block;
  margin: 24rpx auto;
  padding: 16rpx 0;
  width: 320rpx;
  border: 1rpx solid #444;
  border-radius: 12rpx;
  color: #999;
}

.done-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: #1f8a4c;
  color: #fff;
  font-size: 64rpx;
}

.done-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.done-meta {
  color: #888;
  font-size: 28rpx;
  line-height: 1.8;
}

.done-hint {
  color: #666;
  font-size: 26rpx;
  line-height: 1.8;
  margin-top: 32rpx;
}

.reopen-btn {
  display: inline-block;
  margin-top: 40rpx;
  padding: 18rpx 64rpx;
  background: #ffffff;
  color: #111;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
}

/* 提交过一版的顶部提示条 */
.resubmit-tip {
  margin-bottom: 16rpx;
  padding: 14rpx 20rpx;
  background: #faeeda;
  color: #8a5a1e;
  font-size: 24rpx;
  line-height: 1.6;
  border-radius: 8rpx;
}

/* 自动保存失败：顶部常驻提示（F-23）。成功时整条不出现（BR-503 静默） */
.unsaved-bar {
  margin-bottom: 16rpx;
  padding: 14rpx 20rpx;
  background: #3a1f1f;
  color: #ff9b8a;
  font-size: 24rpx;
  line-height: 1.6;
  border-radius: 8rpx;
}

/* 空态：摄影师一张都还没传的情况（F-23） */
.empty-photos {
  margin-top: 18vh;
}

.empty-photos .empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.head {
  margin-bottom: 24rpx;
}

.name {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.meta {
  color: #888;
  font-size: 26rpx;
}

.num {
  color: #4cd97b;
  font-weight: 600;
}

/* 瀑布流：两列等宽 flex，列内竖向堆叠。高度由 JS 算好写在 style 上 */
.masonry {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.col {
  flex: 1;
  /* 关键：不给 width:0，长文件名/大图会把列撑宽导致两列不等宽 */
  width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cell {
  position: relative;
  background: #1a1a1a;
  border-radius: 8rpx;
  overflow: hidden;
}

/* 缩略图加载失败：就地提示 + 重试，不留一片黑格子 */
.cell-fail {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: #888;
  background: #1f1f1f;
}

.cf-btn {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #fff;
  background: #4caf7d;
  border-radius: 999rpx;
}

/* 已选：绿框 + 右上角对勾（54 第 6 节三端统一规范 #4CAF7D）
   用 inset 阴影描边，不占位、不影响图片裁切 */
.cell.on {
  box-shadow: inset 0 0 0 3rpx #4caf7d;
}

.thumb {
  width: 100%;
  height: 100%;
  /* 没加载出来之前留占位：格子底色（#1a1a1a）可见，不是白块也不是裂图 */
  opacity: 0;
}

/* 加载完成 → 淡入，替代 4G 下的「跳入」（11_INTERACTION_SPEC 第九章：200ms ease） */
.thumb.anim {
  opacity: 1;
  transition: opacity 200ms ease;
}

/* 命中本地缓存的图几乎瞬时返回，直接显示，避免反而闪一下 */
.thumb.fast {
  opacity: 1;
}

/* 徽章外层点击热区：视觉圆圈不变，可点面积更大，好按 */
.badge-hit {
  position: absolute;
  right: 0;
  top: 0;
  padding: 12rpx;
}

.badge {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  background: rgba(0, 0, 0, 0.35);
  color: transparent;
  font-size: 30rpx;
  box-sizing: border-box;
}

/* 选中：绿色实心圆 + 白色对勾，状态一眼可辨 */
.badge.on {
  background: #1f8a4c;
  border-color: #1f8a4c;
  color: #ffffff;
  font-weight: 600;
}

.head-left {
  flex: 1;
}

.select-all {
  flex: none;
  font-size: 24rpx;
  color: #cccccc;
  border: 1rpx solid #3a3a3a;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

.more {
  text-align: center;
  color: #666;
  font-size: 24rpx;
  padding: 24rpx 0;
}

.bar-space {
  height: 140rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #161616;
  border-top: 1rpx solid #2a2a2a;
}

.bar-info {
  flex: 1;
  color: #fff;
  font-size: 30rpx;
}

.bar-btn {
  background: #ffffff;
  color: #111111;
  font-size: 30rpx;
  padding: 20rpx 60rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.bar-btn.disabled {
  opacity: 0.5;
}

/* E-10：全部 / 已选 两档 Tab（本地过滤，不请求） */
.tabs {
  display: flex;
  margin: 8rpx 0 20rpx;
}

.tab {
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #999;
  background: #1a1a1a;
  border: 1rpx solid #2a2a2a;
  border-radius: 999rpx;
}

.tab.on {
  color: #0d0d0d;
  background: #4caf7d;
  border-color: #4caf7d;
}

/* E-5：首次进入的一次性引导蒙层 */
.gmask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
}

.gcard {
  width: 560rpx;
  padding: 40rpx 36rpx;
  background: #171717;
  border: 1rpx solid #2e2e2e;
  border-radius: 24rpx;
}

.gtitle {
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.grow {
  margin-bottom: 14rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #cfcfcf;
}

.gok {
  margin-top: 24rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #0d0d0d;
  background: #4caf7d;
  border-radius: 999rpx;
}
