<view class="page">
  <view wx:if="{{!ready}}" class="hint">加载中…</view>

  <block wx:else>
    <swiper class="swiper" current="{{current}}" bindchange="onSwiper">
      <swiper-item wx:for="{{photos}}" wx:key="_id">
        <movable-area class="zoom-area" scale-area>
          <movable-view
            class="zoom-view"
            direction="all"
            scale="{{true}}"
            scale-min="1"
            scale-max="4"
            scale-value="{{zoomValue}}"
            animation="{{false}}"
            bindscale="onScale"
            bindtap="onTapPhoto"
            catch:htouchmove="{{zoomed ? 'blockSwiper' : ''}}"
            catch:vtouchmove="{{zoomed ? 'blockSwiper' : ''}}"
          >
            <image
              class="big"
              src="{{index === current ? previewUrl : item.thumbUrl}}"
              mode="aspectFit"
            />
          </movable-view>
        </movable-area>
      </swiper-item>
    </swiper>

    <view class="topbar">
      {{current + 1}} / {{photos.length}}
    </view>

    <view wx:if="{{showGestureHint}}" class="gesture-hint">双指缩放看细节 · 放大后可拖动看边角 · 轻点选片</view>

    <!-- 放大状态下左右滑动被屏蔽（避免误切图），给一个明确的还原入口 -->
    <view wx:if="{{zoomed}}" class="reset-zoom" catchtap="resetZoom">缩回原图</view>

    <view class="bottombar">
      <view class="filename">{{photos[current].filename}}</view>
      <view
        class="like {{photos[current].selected ? 'on' : ''}} {{locked ? 'disabled' : ''}}"
        bindtap="toggleLike"
      >{{photos[current].selected ? '✓ 已选' : '♡ 喜欢'}}</view>
    </view>
  </block>
</view>
