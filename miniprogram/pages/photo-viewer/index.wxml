<wxs src="./gest.wxs" module="gest" />
<view class="page">
  <view wx:if="{{!ready}}" class="hint">加载中…</view>

  <block wx:else>
    <!-- 手势全部由 gest.wxs 在渲染层处理（缩放/拖动/翻页），不走逻辑层，保证丝滑 -->
    <view
      class="stage"
      data-w="{{windowW}}"
      data-h="{{windowH}}"
      data-count="{{photos.length}}"
      data-i="{{current}}"
      catchtouchstart="{{gest.onStart}}"
      catchtouchmove="{{gest.onMove}}"
      catchtouchend="{{gest.onEnd}}"
      catchtouchcancel="{{gest.onTouchCancel}}"
    >
      <view class="track" id="track" style="transform: translateX(-{{current * 100}}vw)">
        <view class="slide" wx:for="{{photos}}" wx:key="_id">
          <view class="img-wrap" id="wrap{{index}}">
            <image
              class="big"
              src="{{previewUrls[index] || item.thumbUrl}}"
              mode="aspectFit"
              lazy-load="{{true}}"
            />
          </view>
        </view>
      </view>
    </view>

    <view class="topbar">
      {{current + 1}} / {{photos.length}}
    </view>

    <view wx:if="{{showGestureHint}}" class="gesture-hint">双指缩放看细节 · 双击放大 · 轻点选片 · 放大后贴边再滑可切图</view>

    <view class="bottombar">
      <view class="filename">{{photos[current].filename}}</view>
      <view
        class="like {{photos[current].selected ? 'on' : ''}} {{locked ? 'disabled' : ''}}"
        catchtap="toggleLike"
      >{{photos[current].selected ? '✓ 已选' : '♡ 喜欢'}}</view>
    </view>
  </block>
</view>
