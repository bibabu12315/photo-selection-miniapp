// 图片查看器手势处理（WXS）
// 为什么用 WXS：普通事件回调走「渲染层 → 逻辑层 → setData → 渲染层」跨线程链路，
// 每帧都有延迟，表现为卡顿；WXS 直接在渲染层线程执行，transform 逐帧更新，接近原生丝滑。
// 状态机：idle → pending(单击/双击判定) → track(1倍下左右切页) / pan(放大后拖动) / pinch(双指缩放)
// 边缘行为（微信同款）：放大后拖到图片边缘，继续拖会把翻页轨道"拖出来"（带阻尼），
// 第一次松手回弹；图片已贴边时再拖超过阈值就翻页。

var state = {
  ready: false,
  pageW: 0,
  pageH: 0,
  count: 0,
  index: 0,
  scale: 1,
  panX: 0,
  panY: 0,
  mode: 'idle',
  startX: 0,
  startY: 0,
  startT: 0,
  lastTapT: 0,
  startDist: 0,
  baseScale: 1,
  basePanX: 0,
  basePanY: 0,
  baseMidX: 0,
  baseMidY: 0,
  baseTrackX: 0,
  overX: 0,
  moved: false,
}

function dist(t) {
  var dx = t[0].pageX - t[1].pageX
  var dy = t[0].pageY - t[1].pageY
  return Math.sqrt(dx * dx + dy * dy)
}

function clamp(v, a, b) {
  return v < a ? a : v > b ? b : v
}

function bounds() {
  return {
    bx: ((state.scale - 1) * state.pageW) / 2,
    by: ((state.scale - 1) * state.pageH) / 2,
  }
}

function applyZoom(wrap, withTransition) {
  if (!wrap) return
  wrap.setStyle({
    transition: withTransition ? 'transform 0.25s ease-out' : 'none',
    transform:
      'translate(' + state.panX + 'px,' + state.panY + 'px) scale(' + state.scale + ')',
  })
}

function applyTrack(track, x, withTransition) {
  if (!track) return
  track.setStyle({
    transition: withTransition ? 'transform 0.25s ease-out' : 'none',
    transform: 'translateX(' + x + 'px)',
  })
}

function beginPinch(event) {
  state.mode = 'pinch'
  state.startDist = dist(event.touches)
  state.baseScale = state.scale
  state.basePanX = state.panX
  state.basePanY = state.panY
  state.baseMidX = (event.touches[0].pageX + event.touches[1].pageX) / 2
  state.baseMidY = (event.touches[0].pageY + event.touches[1].pageY) / 2
}

function onStart(event, ins) {
  var ds = event.currentTarget.dataset
  if (!state.ready) {
    state.ready = true
    state.pageW = ds.w
    state.pageH = ds.h
    state.count = ds.count
    state.index = ds.i || 0
    state.baseTrackX = -state.index * state.pageW
  }
  if (event.touches.length >= 2) {
    beginPinch(event)
    return
  }
  state.mode = 'pending'
  state.startX = event.touches[0].pageX
  state.startY = event.touches[0].pageY
  state.startT = event.timeStamp
  state.moved = false
  state.overX = 0
  state.basePanX = state.panX
  state.basePanY = state.panY
  state.baseTrackX = -state.index * state.pageW
}

function onMove(event, ins) {
  if (!state.ready) return
  var track = ins.selectComponent('#track')
  var wrap = ins.selectComponent('#wrap' + state.index)

  // 双指：缩放 + 双指拖动（从中途加入第二根手指也能平滑接管）
  if (event.touches.length >= 2) {
    if (state.mode !== 'pinch') beginPinch(event)
    var d = dist(event.touches)
    var midX = (event.touches[0].pageX + event.touches[1].pageX) / 2
    var midY = (event.touches[0].pageY + event.touches[1].pageY) / 2
    var s = (state.baseScale * d) / state.startDist
    if (s < 1) s = 1 + (s - 1) * 0.3
    if (s > 4) s = 4 + (s - 4) * 0.3
    state.scale = s
    var b = bounds()
    state.panX = clamp(state.basePanX + (midX - state.baseMidX), -b.bx, b.bx)
    state.panY = clamp(state.basePanY + (midY - state.baseMidY), -b.by, b.by)
    applyZoom(wrap, false)
    return
  }

  if (event.touches.length !== 1) return
  var x = event.touches[0].pageX
  var y = event.touches[0].pageY
  var dx = x - state.startX
  var dy = y - state.startY

  // 单指：先判定意图（放大拖图 or 1倍翻页 or 无操作）
  if (state.mode === 'pending') {
    if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return
    if (state.scale > 1.02) {
      state.mode = 'pan'
    } else if (Math.abs(dx) > Math.abs(dy)) {
      state.mode = 'track'
    } else {
      state.mode = 'idle'
      return
    }
  }

  if (state.mode === 'pan') {
    var b2 = bounds()
    var rawX = state.basePanX + dx
    var clampedX = clamp(rawX, -b2.bx, b2.bx)
    state.overX = rawX - clampedX
    state.panX = clampedX
    state.panY = clamp(state.basePanY + dy, -b2.by, b2.by)
    applyZoom(wrap, false)
    // 图片贴边后继续拖：带动翻页轨道（阻尼 0.35），即微信"第一次滑弹回、再滑一下切页"的手感
    if (track && state.overX !== 0) {
      applyTrack(track, -state.index * state.pageW + state.overX * 0.35, false)
    }
    return
  }

  if (state.mode === 'track') {
    var raw = state.baseTrackX + dx
    var first = 0
    var last = -(state.count - 1) * state.pageW
    var cl = raw
    var over = 0
    if (raw > first) {
      over = raw - first
      cl = first + over * 0.35
    } else if (raw < last) {
      over = raw - last
      cl = last + over * 0.35
    }
    state.overX = over
    state.trackX = cl
    applyTrack(track, cl, false)
  }
}

function resetPage(wrap) {
  state.scale = 1
  state.panX = 0
  state.panY = 0
  if (wrap) {
    wrap.setStyle({
      transition: 'none',
      transform: 'translate(0px,0px) scale(1)',
    })
  }
}

function onEnd(event, ins) {
  if (!state.ready) return
  var track = ins.selectComponent('#track')
  var wrap = ins.selectComponent('#wrap' + state.index)

  // 双指松开：超出边界的倍率回弹
  if (state.mode === 'pinch') {
    state.scale = clamp(state.scale, 1, 4)
    var b = bounds()
    state.panX = clamp(state.panX, -b.bx, b.bx)
    state.panY = clamp(state.panY, -b.by, b.by)
    applyZoom(wrap, true)
    if (track) applyTrack(track, -state.index * state.pageW, true)
    state.mode = 'idle'
    ins.callMethod('onZoomChanged', { zoomed: state.scale > 1.02 })
    return
  }

  // 1倍下翻页：滑动距离或速度过阈值 → 翻页，否则回弹
  if (state.mode === 'track') {
    var target = state.index
    var dt = Math.max(event.timeStamp - state.startT, 1)
    var vx = (event.changedTouches[0].pageX - state.startX) / dt
    if (state.overX < -state.pageW * 0.22 || vx < -0.45) target = state.index + 1
    else if (state.overX > state.pageW * 0.22 || vx > 0.45) target = state.index - 1
    if (target < 0) target = 0
    if (target > state.count - 1) target = state.count - 1
    if (target !== state.index) {
      resetPage(wrap)
      state.index = target
      ins.callMethod('onSwitched', { index: target })
    }
    state.trackX = -state.index * state.pageW
    applyTrack(track, state.trackX, true)
    state.mode = 'idle'
    return
  }

  // 放大后拖动：贴边继续拖过阈值 → 翻页；否则图片和轨道都回弹
  if (state.mode === 'pan') {
    var dir = 0
    if (state.overX < -60) dir = 1
    else if (state.overX > 60) dir = -1
    var next = state.index + dir
    if (dir !== 0 && next >= 0 && next <= state.count - 1) {
      resetPage(wrap)
      state.index = next
      state.trackX = -state.index * state.pageW
      applyTrack(track, state.trackX, true)
      ins.callMethod('onSwitched', { index: state.index })
    } else {
      var b3 = bounds()
      state.panX = clamp(state.panX, -b3.bx, b3.bx)
      applyZoom(wrap, true)
      if (track && state.overX !== 0) {
        applyTrack(track, -state.index * state.pageW, true)
      }
    }
    state.mode = 'idle'
    return
  }

  // 没怎么动 → 单击 / 双击判定
  if (state.mode === 'pending') {
    var touch = event.changedTouches[0]
    var moveDist =
      Math.abs(touch.pageX - state.startX) + Math.abs(touch.pageY - state.startY)
    if (moveDist < 10) {
      if (event.timeStamp - state.lastTapT < 300) {
        state.lastTapT = 0
        if (state.scale > 1.02) {
          state.scale = 1
          state.panX = 0
          state.panY = 0
        } else {
          state.scale = 2
        }
        applyZoom(wrap, true)
        ins.callMethod('onZoomChanged', { zoomed: state.scale > 1.02 })
      } else {
        state.lastTapT = event.timeStamp
        ins.callMethod('onSingleTap', {})
      }
    }
    state.mode = 'idle'
    return
  }

  state.mode = 'idle'
}

function onTouchCancel(event, ins) {
  onEnd(event, ins)
}

module.exports = {
  onStart: onStart,
  onMove: onMove,
  onEnd: onEnd,
  onTouchCancel: onTouchCancel,
}
