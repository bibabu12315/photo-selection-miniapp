.page {
  width: 100vw;
  height: 100vh;
  background: #000;
  position: relative;
  overflow: hidden;
}

.hint {
  color: #666;
  text-align: center;
  margin-top: 50vh;
  font-size: 28rpx;
}

/* 手势舞台：所有触摸事件在渲染层由 gest.wxs 消费 */
.stage {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

/* 翻页轨道：横向排开所有照片，WXS 控制 translateX */
.track {
  display: flex;
  height: 100%;
  will-change: transform;
}

.slide {
  width: 100vw;
  height: 100%;
  flex: none;
}

/* 缩放/拖动作用在这一层，WXS 控制 transform */
.img-wrap {
  width: 100%;
  height: 100%;
  will-change: transform;
}

.big {
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.topbar {
  position: absolute;
  top: calc(16rpx + env(safe-area-inset-top));
  left: 0;
  right: 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  pointer-events: none;
}

/* 手势提示气泡：首次进入出现，几秒后消失 */
.gesture-hint {
  position: absolute;
  top: calc(80rpx + env(safe-area-inset-top));
  left: 50%;
  transform: translateX(-50%);
  padding: 12rpx 32rpx;
  background: rgba(0, 0, 0, 0.6);
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  pointer-events: none;
}

.bottombar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.75));
  pointer-events: none;
}

.bottombar .like {
  pointer-events: auto;
}

.filename {
  flex: 1;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.like {
  color: #fff;
  font-size: 30rpx;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.like.on {
  background: #1f8a4c;
  border-color: #1f8a4c;
}

.like.disabled {
  opacity: 0.4;
}
