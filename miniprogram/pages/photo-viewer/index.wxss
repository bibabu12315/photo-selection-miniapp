.page {
  width: 100vw;
  height: 100vh;
  background: #000;
  position: relative;
}

.hint {
  color: #666;
  text-align: center;
  margin-top: 50vh;
  font-size: 28rpx;
}

.swiper {
  width: 100%;
  height: 100%;
}

.big {
  width: 100%;
  height: 100%;
}

.topbar {
  position: absolute;
  top: calc(16rpx + env(safe-area-inset-top));
  left: 0;
  right: 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  pointer-events: none;
}

.bottombar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.75));
}

.filename {
  flex: 1;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.like {
  color: #fff;
  font-size: 30rpx;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.like.on {
  background: #1f8a4c;
  border-color: #1f8a4c;
}

.like.disabled {
  opacity: 0.4;
}
